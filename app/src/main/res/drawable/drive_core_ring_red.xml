<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="270"
                android:centerColor="#FF6A6A"
                android:endColor="#C62828"
                android:startColor="#FF9E9E" />
            <stroke
                android:width="2dp"
                android:color="#FFF5F5" />
        </shape>
    </item>
    <item
        android:bottom="13dp"
        android:left="13dp"
        android:right="13dp"
        android:top="13dp">
        <shape android:shape="oval">
            <solid android:color="#AA220000" />
            <stroke
                android:width="1dp"
                android:color="#88FFFFFF" />
        </shape>
    </item>
</layer-list>

