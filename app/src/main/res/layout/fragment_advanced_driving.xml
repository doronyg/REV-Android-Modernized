<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/advanced_mode_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:clipChildren="false"
    android:clipToPadding="false">

    <View
        android:id="@+id/driver_touch_area"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <com.wowwee.revandroidsampleproject.utils.JoystickView
        android:id="@+id/layoutLeverControl"
        android:layout_width="132dp"
        android:layout_height="360dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:layout_marginStart="20dp"
        android:tag="ignore_scaling">

        <ImageView
            android:id="@+id/joystickBaseL"
            android:layout_width="132dp"
            android:layout_height="360dp"
            android:background="@drawable/drive_lever_track" />

        <View
            android:id="@+id/leverCenterMarker"
            android:layout_width="104dp"
            android:layout_height="3dp"
            android:layout_gravity="center"
            android:background="@drawable/drive_lever_center_marker" />

        <TextView
            android:id="@+id/tvLeverForward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="top|center_horizontal"
            android:layout_marginTop="10dp"
            android:text="@string/advanced_mode_forward_short"
            android:textColor="#FF6B6B"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvLeverBackward"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom|center_horizontal"
            android:layout_marginBottom="10dp"
            android:text="@string/advanced_mode_backward_short"
            android:textColor="#FF6B6B"
            android:textSize="14sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/joystickL"
            android:layout_width="76dp"
            android:layout_height="76dp"
            android:background="@drawable/drive_core_ring_red" />
    </com.wowwee.revandroidsampleproject.utils.JoystickView>

    <com.wowwee.revandroidsampleproject.utils.JoystickView
        android:id="@+id/layoutWheelControl"
        android:layout_width="320dp"
        android:layout_height="300dp"
        android:layout_centerHorizontal="true"
        android:layout_centerVertical="true"
        android:layout_marginTop="0dp"
        android:translationY="-56dp"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:tag="ignore_scaling">

        <ImageView
            android:id="@+id/joystickBaseR"
            android:layout_width="320dp"
            android:layout_height="176dp"
            android:layout_gravity="bottom|center_horizontal"
            android:background="@drawable/drive_wheel_half" />

        <ImageView
            android:id="@+id/joystickR"
            android:layout_width="82dp"
            android:layout_height="82dp"
            android:background="@drawable/drive_thumb_race_car" />
    </com.wowwee.revandroidsampleproject.utils.JoystickView>

    <TextView
        android:id="@+id/tvDriverModeTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="20dp"
        android:text="@string/advanced_mode_title"
        android:textColor="?android:textColorPrimary"
        android:textSize="18sp" />

    <Button
        android:id="@+id/btnStartGame"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="8dp"
        android:layout_toStartOf="@id/tvBatteryLevel"
        android:background="@drawable/advanced_mode_bubble"
        android:elevation="3dp"
        android:text="@string/advanced_mode_start_game_short"
        android:textAllCaps="false"
        android:textColor="#FFFFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnMode"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/advanced_mode_bubble"
        android:elevation="3dp"
        android:text="@string/driver_mode_short"
        android:textAllCaps="false"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvBatteryLevel"
        android:layout_width="88dp"
        android:layout_height="36dp"
        android:layout_alignTop="@id/btnMode"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_toStartOf="@id/btnMode"
        android:background="@drawable/advanced_battery_pill_background"
        android:elevation="3dp"
        android:gravity="center"
        android:text="0"
        android:textColor="#FFFFFFFF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnFire"
        android:layout_width="144dp"
        android:layout_height="64dp"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginEnd="16dp"
        android:background="@drawable/advanced_fire_button_background"
        android:elevation="3dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:text="@string/fire"
        android:textAllCaps="false"
        android:textColor="?android:textColorPrimaryInverse"
        android:textSize="20sp"
        android:textStyle="bold" />

    <Button
        android:id="@+id/btnSimulateHit"
        android:layout_width="120dp"
        android:layout_height="40dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="16dp"
        android:background="?attr/colorButtonNormal"
        android:text="@string/advanced_mode_simulate_hit"
        android:textAllCaps="false"
        android:textColor="?android:textColorPrimary"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnSimulateOtherHit"
        android:layout_width="136dp"
        android:layout_height="40dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="16dp"
        android:layout_toEndOf="@id/btnSimulateHit"
        android:background="?attr/colorButtonNormal"
        android:text="@string/advanced_mode_simulate_other_hit"
        android:textAllCaps="false"
        android:textColor="?android:textColorPrimary"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnSimulateBump"
        android:layout_width="120dp"
        android:layout_height="40dp"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="16dp"
        android:layout_toEndOf="@id/btnSimulateOtherHit"
        android:background="?attr/colorButtonNormal"
        android:text="@string/advanced_mode_simulate_bump"
        android:textAllCaps="false"
        android:textColor="?android:textColorPrimary"
        android:visibility="gone" />

    <FrameLayout
        android:id="@+id/hitSplashOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#66FF3B30"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/advanced_mode_hit_overlay"
            android:textColor="#FFFFFFFF"
            android:textSize="48sp"
            android:textStyle="bold" />
    </FrameLayout>

</RelativeLayout>

